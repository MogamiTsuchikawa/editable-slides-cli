{
  "name": "editable-slides-cli",
  "version": "0.1.0",
  "description": "CLI for creating, previewing, validating, and exporting editable slide decks",
  "keywords": [
    "slides",
    "presentation",
    "powerpoint",
    "pptx",
    "pdf",
    "slide-deck"
  ],
  "license": "MIT",
  "homepage": "https://github.com/MogamiTsuchikawa/editable-slides-cli#readme",
  "bugs": {
    "url": "https://github.com/MogamiTsuchikawa/editable-slides-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MogamiTsuchikawa/editable-slides-cli.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "slide": "dist/bin/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "build:template-archive": "node scripts/build-template-archive.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build:core --prefix ../.. && npm run build",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "1.62.0"
  },
  "devDependencies": {
    "@editable-slides/slide-compiler": "*",
    "@editable-slides/slide-deck-ir": "*",
    "@editable-slides/slide-exporter-pdf": "*",
    "@editable-slides/slide-qa-pptx": "*",
    "@editable-slides/slide-renderer-pptx": "*",
    "@editable-slides/slide-theme-default": "*",
    "@types/node": "^24.10.0",
    "@types/yauzl": "3.4.0",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.1",
    "jszip": "3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1",
    "yauzl": "3.4.0"
  }
}
